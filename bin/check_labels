#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open-uri"

pull_request_url = ARGV.first

unless pull_request_url
  warn("Missing argument for pull request URL")
  exit(1)
end

# Read public PR data without authentication to avoid organization IP restrictions.
label_info = URI.parse(pull_request_url).read("Accept" => "application/vnd.github+json")
pr_labels = JSON.parse(label_info, symbolize_names: true)[:labels].map { |label| label[:name] }

# If the PR includes at least one of the labels ignored for release notes, then exit successfully
ignored_labels = ["documentation", "chore", "dependencies"]
exit(0) if (pr_labels & ignored_labels).any?

# Otherwise, the PR must indicate what type of change it is
type_labels = ["bugfix", "enhancement", "breaking-change", "other"]

if (pr_labels & type_labels).empty?
  warn("PRs requiring release notes must have a change type label: #{type_labels.join(", ")}")
  warn("For changes that do not require release notes, use one of: #{ignored_labels.join(", ")}")
  exit(1)
end

# And it should label the category to which we need to include the notes
category_labels = ["server", "vscode"]

if (pr_labels & category_labels).empty?
  warn("PRs requiring release notes must have a category label: #{category_labels.join(", ")}")
  warn("For changes that do not require release notes, use one of: #{ignored_labels.join(", ")}")
  exit(1)
end
